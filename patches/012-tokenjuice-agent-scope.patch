--- a/extensions/tokenjuice/index.ts
+++ b/extensions/tokenjuice/index.ts
@@ -6,6 +6,15 @@
   name: "tokenjuice",
   description: "Compacts exec and bash tool results with tokenjuice reducers.",
   register(api) {
-    api.registerAgentToolResultMiddleware(createTokenjuiceAgentToolResultMiddleware());
+    const agentIds = api.pluginConfig?.agentIds;
+    if (!Array.isArray(agentIds) || agentIds.length === 0) {
+      return;
+    }
+    const middleware = createTokenjuiceAgentToolResultMiddleware();
+    api.registerAgentToolResultMiddleware((event, ctx) => {
+      if (ctx.agentId && agentIds.includes(ctx.agentId)) {
+        return middleware(event, ctx);
+      }
+    });
   },
 });
