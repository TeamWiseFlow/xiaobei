{
  "name": "@openclaw/awada",
  "version": "2026.10.4",
  "description": "OpenClaw Awada channel plugin — WeChat via relay gateway (HTTP/WS transport)",
  "type": "module",
  "dependencies": {
    "silk-wasm": "3.7.1",
    "typebox": "1.3.34",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "awada",
      "label": "Awada",
      "selectionLabel": "Awada (WeChat via relay gateway)",
      "blurb": "WeChat (enterprise/personal) via awada relay gateway (HTTP/WS transport).",
      "order": 80
    },
    "install": {
      "localPath": "awada",
      "defaultChoice": "local",
      "minHostVersion": ">=2026.10.4"
    }
  }
}
