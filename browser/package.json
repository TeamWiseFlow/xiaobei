{
  "name": "@wiseflow/browser",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "WiseFlow managed Camoufox runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "xiaobei-browser": "./dist/cli.js",
    "camoufox-cli": "./dist/compat/cli.js"
  },
  "exports": {
    "./client": "./dist/client/index.js",
    "./protocol": "./dist/protocol/index.js",
    "./driver": "./dist/driver/sdk.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/finalize-build.mjs",
    "test": "npm run build && node --test ../test/browser/*.test.mjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "camoufox": "0.5.8",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1",
    "typebox": "1.3.34",
    "maxmind": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "bridge",
    "scripts",
    "assets.lock.json",
    "data",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "plugin",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./plugin/index.ts"
    ],
    "install": {
      "localPath": "browser",
      "minHostVersion": ">=2026.10.4"
    }
  }
}
