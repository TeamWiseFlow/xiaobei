{
  "update": {
    "checkOnStart": false,
    "auto": {
      "enabled": false
    }
  },
  "logging": {
    "level": "warn",
    "consoleLevel": "warn",
    "file": "~/.openclaw/logs/gateway.log",
    "maxFileBytes": 10485760
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "bailian": {
        "baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
        "apiKey": "${AWK_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "deepseek-v4.1-flash",
            "name": "deepseek-v4.1-flash",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 1000000,
            "maxTokens": 393216,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "thinkingFormat": "openai"
            }
          },
          {
            "id": "qwen3.8-flash",
            "name": "qwen3.8-flash",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 983616,
            "maxTokens": 131072,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "thinkingFormat": "openai"
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "bailian/deepseek-v4.1-flash",
        "fallbacks": [
          "bailian/qwen3.8-flash"
        ]
      },
      "imageModel": {
        "primary": "bailian/qwen3.8-flash",
        "fallbacks": [
          "bailian/deepseek-v4.1-flash"
        ]
      },
      "models": {
        "bailian/deepseek-v4.1-flash": {},
        "bailian/qwen3.8-flash": {}
      },
      "compaction": {
        "mode": "safeguard"
      },
      "thinkingDefault": "medium",
      "heartbeat": {
        "every": "0m"
      },
      "maxConcurrent": 3,
      "subagents": {
        "maxConcurrent": 4,
        "announceTimeoutMs": 3600000,
        "maxSpawnDepth": 2
      },
      "modelPolicy": {
        "allow": [
          "bailian/deepseek-v4.1-flash",
          "bailian/qwen3.8-flash"
        ]
      },
      "systemAgent": {
        "agentId": "it-engineer"
      }
    },
    "entries": {
      "main": {
        "name": "小贝",
        "workspace": "~/.openclaw/workspace-main",
        "skills": [
          "smart-search",
          "browser-guide",
          "email-ops",
          "visualize",
          "tmux"
        ],
        "subagents": {
          "allowAgents": [
            "it-engineer",
            "content-producer"
          ]
        },
        "tools": {
          "exec": {
            "host": "gateway",
            "mode": "full"
          }
        },
        "reasoningDefault": "off"
      },
      "it-engineer": {
        "name": "IT Engineer",
        "workspace": "~/.openclaw/workspace-it-engineer",
        "skills": [
          "healthcheck",
          "nano-pdf",
          "skill-creator",
          "visualize",
          "tmux",
          "node-connect",
          "github",
          "gh-issues",
          "coding-agent",
          "configure-channel",
          "add-model-provider",
          "diagnose-gateway",
          "cloud-image-bake"
        ],
        "tools": {
          "exec": {
            "host": "gateway",
            "mode": "full"
          }
        },
        "reasoningDefault": "off"
      },
      "content-producer": {
        "name": "producer",
        "workspace": "~/.openclaw/workspace-content-producer",
        "skills": [
          "smart-search",
          "browser-guide",
          "visualize",
          "tmux"
        ],
        "subagents": {
          "allowAgents": [
            "it-engineer"
          ]
        },
        "tools": {
          "exec": {
            "host": "gateway",
            "mode": "allowlist"
          }
        },
        "reasoningDefault": "off"
      }
    },
    "ownership": "explicit"
  },
  "bindings": [
    {
      "agentId": "main",
      "comment": "openclaw-weixin -> Main Agent onboarding entry",
      "match": {
        "channel": "openclaw-weixin",
        "accountId": "*"
      }
    }
  ],
  "messages": {
    "ackReactionScope": "group-mentions",
    "inbound": {
      "debounceMs": 1500
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 2880
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "boot-md": {
          "enabled": false
        },
        "command-logger": {
          "enabled": true
        },
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "openclaw-weixin": {
      "enabled": true
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": ""
    },
    "tailscale": {
      "mode": "off"
    },
    "nodes": {
      "commands": {
        "deny": [
          "camera.snap",
          "camera.clip",
          "screen.record",
          "calendar.add",
          "contacts.add",
          "reminders.add"
        ]
      }
    }
  },
  "skills": {
    "entries": {
      "notion": {
        "enabled": false
      },
      "obsidian": {
        "enabled": false
      },
      "trello": {
        "enabled": false
      },
      "github": {
        "enabled": true
      },
      "gh-issues": {
        "enabled": true
      },
      "coding-agent": {
        "enabled": true
      },
      "gemini": {
        "enabled": false
      },
      "openai-whisper": {
        "enabled": false
      },
      "openai-whisper-api": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      },
      "spotify-player": {
        "enabled": false
      },
      "mcporter": {
        "enabled": false
      },
      "xurl": {
        "enabled": false
      },
      "clawhub": {
        "enabled": false
      },
      "slack": {
        "enabled": false
      },
      "wacli": {
        "enabled": false
      },
      "voice-call": {
        "enabled": false
      },
      "discord": {
        "enabled": false
      },
      "canvas": {
        "enabled": false
      },
      "block-kit": {
        "enabled": false
      },
      "browser-automation": {
        "enabled": false
      },
      "crabbox-apps": {
        "enabled": false
      },
      "facetime": {
        "enabled": false
      },
      "ordercli": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "control-ui": {
        "enabled": false
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "${XIAOBEI_HOME}/awada",
        "${XIAOBEI_HOME}/browser"
      ]
    },
    "entries": {
      "awada": {
        "enabled": false
      },
      "xai": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      },
      "xiaobei-browser": {
        "enabled": true
      },
      "phone-control": {
        "enabled": false
      },
      "google-meet": {
        "enabled": false
      },
      "teams-meetings": {
        "enabled": false
      },
      "zoom-meetings": {
        "enabled": false
      },
      "codex": {
        "enabled": false
      },
      "memory-core": {
        "enabled": true
      },
      "openclaw-weixin": {
        "enabled": true
      }
    }
  },
  "tools": {
    "exec": {
      "host": "gateway"
    },
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "ssrfPolicy": {
          "allowRfc2544BenchmarkRange": true,
          "allowIpv6UniqueLocalRange": true
        }
      }
    }
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true
    },
    "lastTouchedVersion": "2026.10.4"
  },
  "talk": {
    "agentId": "main"
  }
}
